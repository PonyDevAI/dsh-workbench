{
  "name": "@ponydev/dsh-workbench",
  "version": "0.2.0",
  "description": "DSH Web 插件：个人工作台——独立账号（飞书 Device Flow / GitHub PAT），以本人身份只读采集 Lark/GitHub 增量消息与 PR 动态",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "workbench",
    "lark",
    "feishu",
    "github",
    "review"
  ],
  "license": "MIT",
  "author": "Pony <205503242+jmaubay7@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PonyDevAI/dsh-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/PonyDevAI/dsh-workbench/issues"
  },
  "homepage": "https://github.com/PonyDevAI/dsh-workbench#readme",
  "type": "module",
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "docs/*.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "AGENTS.md"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0",
    "node": ">=22.5"
  },
  "scripts": {
    "check": "node scripts/check-syntax.mjs && node scripts/check-i18n.mjs && node scripts/check-privacy.mjs && node scripts/verify-plugin.mjs",
    "smoke": "node scripts/smoke.mjs",
    "release-notes": "node scripts/release-notes.mjs",
    "test-ui": "node scripts/render-test.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
